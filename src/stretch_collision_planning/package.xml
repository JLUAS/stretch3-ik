  <version>0.1.0</version>
  <description>Collision-aware C-space planning primitives for Stretch manipulation.</description>
  <maintainer email="jlurquieta1@gmail.com">JLUAS</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>ament_index_cpp</depend>
  <depend>octomap</depend>
  <depend>octomap_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>stretch_custom_kinematics</depend>
  <depend>stretch_robot_interface</depend>
  <depend>tf2</depend>
