<?xml version="1.0"?>
<package format="3">
  <name>stretch_robot_interface</name>
  <version>0.1.0</version>
  <description>Read-only Stretch 3 robot state interface: URDF model, joint decoding, freshness and homed/runstop flags.</description>
  <maintainer email="jlurquieta1@gmail.com">JLUAS</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>eigen</depend>
  <depend>urdf</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
