Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 229
- Class: stretch_custom_kinematics/IkStatusPanel
  Name: IK Preview Status
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 0.25
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Ground
    Plane: XY
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Enabled: true
    Name: Current Robot
    Visual Enabled: true
  - Alpha: 0.44999998807907104
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /ik_preview/robot_description
    Enabled: true
    Name: Ghost robot (preview only)
    TF Prefix: ik_preview
    Visual Enabled: true
  - Class: rviz_default_plugins/InteractiveMarkers
    Enable Transparency: true
    Enabled: true
    Interactive Markers Namespace: /ik_preview/target
    Name: Target TCP - drag controls
    Show Axes: true
    Show Descriptions: true
    Show Visual Aids: true
    Value: true
  - Class: rviz_default_plugins/InteractiveMarkers
    Enable Transparency: true
    Enabled: true
    Interactive Markers Namespace: /manipulation_target
    Name: Global mission target - move and release to run
    Show Axes: true
    Show Descriptions: true
    Show Visual Aids: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: IK result and TCP frames
    Namespaces:
      ik_preview: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /ik_preview/markers
    Value: true
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: true
    Enabled: true
    Name: Navigation map (set 2D Pose Estimate first)
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Planned grasps (best opaque)
    Namespaces:
      grasp: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /grasp_mission/grasps
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Grasp debug (object, planned, pre-grasp, achieved TCP frames)
    Namespaces:
      {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /grasp_mission/debug
    Value: true
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: Selected object
    Namespaces:
      object: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /perception/object_marker
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Collision-planned TCP path
    Namespaces:
      collision_contact_label: true
      collision_voxel_occupied: true
      collision_voxel_unknown: true
      cspace_goal: true
      cspace_label: true
      cspace_projected_edge: true
      cspace_slice: true
      cspace_start: true
      executable_tcp_trajectory: true
      raw_rrt_tcp_path: true
      rejected_collision_capsule: true
      rejected_collision_capsule_ends: true
      simplified_tcp_path: true
      workspace_goal: true
      workspace_start: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /guarded_executor/planned_path
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Name: TF
  - Alpha: 0.35
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Enabled: true
    Name: Global navigation costmap
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Value: true
  - Alpha: 0.5
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Enabled: true
    Name: Local navigation costmap
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/Polygon
    Color: 25; 255; 0
    Enabled: true
    Name: Stowed navigation footprint
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/published_footprint
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Enabled: true
    Name: Navigation LiDAR
    Queue Size: 10
    Reliability Policy: Best Effort
    Size (m): 0.03
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
    Value: true
  - Class: rviz_default_plugins/Path
    Color: 25; 255; 0
    Enabled: true
    Line Style: Lines
    Line Width: 0.03
    Name: Global navigation path
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /plan
    Value: true
  - Class: rviz_default_plugins/Path
    Color: 255; 170; 0
    Enabled: true
    Line Style: Lines
    Line Width: 0.04
    Name: Local navigation trajectory
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_plan
    Value: true
  - Alpha: 1.0
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10.0
      Min Value: -10.0
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Raw RGB-D PointCloud2
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.009999999776482582
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera/depth/color/points
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1.0
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 2.0
      Min Value: -0.2
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 80; 210; 120
    Color Transformer: AxisColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Filtered PointCloud2
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.014999999664723873
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /perception/filtered_points
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: OctoMap occupied voxels
    Namespaces:
      octomap_occupied_voxels: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /perception/octomap_markers
    Value: true
  - Alpha: 0.5
    Class: rviz_default_plugins/RobotModel
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /ik_preview/robot_description
    Enabled: true
    Name: Ghost Robot
    TF Prefix: ik_preview
    Update Interval: 0
    Value: true
    Visual Enabled: true
  Enabled: true
  Global Options:
    Background Color: 28; 32; 40
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0999999046325684
      Focal Point:
        X: 0
        Y: -0.20000000298023224
        Z: 0.75
      Name: Current View
      Pitch: 0.3499999940395355
      Target Frame: <Fixed Frame>
      Yaw: 0.800000011920929
